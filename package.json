{
  "name": "frameui",
  "productName": "FrameUI",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first Electron design IDE for UI/UX designers working from a real product codebase.",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "bun test",
    "build": "bun run typecheck && vite build",
    "verify:capture": "node scripts/verify-capture-fidelity.cjs",
    "smoke:modals": "node scripts/smoke-modal-system.cjs",
    "smoke:new-design": "node scripts/smoke-new-design-capture.cjs",
    "build:mac": "bun run build && bun scripts/run-electron-builder.cjs --mac dmg --x64 --arm64",
    "build:win": "node scripts/stage-windows-crt.cjs && bun run build && bun scripts/run-electron-builder.cjs --win nsis",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sketch-hq/sketch-file-format": "6.5.0",
    "@sketch-hq/sketch-file-format-ts": "^6.5.0",
    "@vue/compiler-core": "3.5.42",
    "@vue/compiler-sfc": "3.5.42",
    "@xyflow/react": "^12.11.6",
    "ajv": "8",
    "buffer-crc32": "^1.0.0",
    "chokidar": "^3.6.0",
    "culori": "4",
    "fontkit": "2.0.4",
    "http-proxy": "1.18.1",
    "ignore": "7.0.8",
    "image-size": "2",
    "immer": "^11.1.18",
    "lucide-react": "^1.42.0",
    "minimatch": "^10.2.6",
    "php-parser": "^3.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "semver": "^7.8.5",
    "svelte": "5.57.0",
    "svg-path-parser": "1.1.0",
    "svgpath": "2.6.0",
    "tar": "^7.5.22",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/culori": "^4.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.9.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/svg-path-parser": "^1.1.6",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "devtools-protocol": "^0.0.1695952",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright-core": "1.47.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
