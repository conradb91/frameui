{
  "name": "frameui",
  "productName": "FrameUI",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first Electron design IDE for UI/UX designers working from a real product codebase.",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "bun test",
    "build": "bun run typecheck && vite build",
    "build:mac": "bun run build && electron-builder --mac dmg",
    "build:win": "bun run build && electron-builder --win nsis",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vue/compiler-core": "3.5.42",
    "@vue/compiler-sfc": "3.5.42",
    "@xyflow/react": "^12.11.6",
    "chokidar": "^3.6.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.42.0",
    "php-parser": "^3.7.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "5.57.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright-core": "1.47.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
