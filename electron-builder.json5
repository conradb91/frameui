// electron-builder config for FrameUI's unsigned V1 proof-of-concept
// builds (spec §29-30). Signing credentials are intentionally NOT
// required to produce these — `sign: null`/`identity: null` below is the
// documented, deliberate choice for this build, not an oversight. When
// FrameUI moves toward public distribution, replace the mac `sign` block
// with a Developer ID Application certificate + notarization credentials,
// and add a Windows code-signing method — the architecture doesn't need
// to change, only these credentials.
{
  appId: 'com.frameui.app',
  productName: 'FrameUI',
  artifactName: 'FrameUI-${version}-${arch}.${ext}',
  beforePack: './scripts/review-build.cjs',
  directories: {
    output: 'release',
    buildResources: 'build',
  },
  extraResources: [
    { from: 'build/icon.png', to: 'icon.png' },
    { from: 'integrations/figma-importer', to: 'frameui-figma-importer' },
  ],
  files: [
    'dist/**/*',
    'dist-electron/**/*',
    'hosting/stacker/**/*',
    'package.json',
  ],
  mac: {
    icon: 'icon.icns',
    target: [{ target: 'dmg', arch: ['arm64', 'x64'] }],
    category: 'public.app-category.developer-tools',
    sign: false,
    hardenedRuntime: false,
  },
  win: {
    extraResources: [{ from: 'build/windows-crt', to: 'windows-crt' }],
    icon: 'icon.ico',
    target: [{ target: 'nsis', arch: ['x64'] }],
    sign: null,
  },
  dmg: { icon: 'icon.icns' },
  nsis: {
    installerIcon: 'icon.ico',
    uninstallerIcon: 'icon.ico',
    installerHeaderIcon: 'icon.ico',
    installerHeader: 'installer-header.bmp',
    installerSidebar: 'installer-sidebar.bmp',
    uninstallerSidebar: 'installer-sidebar.bmp',
    oneClick: false,
    allowToChangeInstallationDirectory: true,
  },
}
