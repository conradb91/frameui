{
  "manifest_version": 3,
  "name": "FrameUI Capture \u2014 Local",
  "version": "0.1.0",
  "description": "Capture editable pages and recorded flows, then export Adobe XD directly in Chrome. Processing stays on your computer.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open FrameUI Capture"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"
  }
}
